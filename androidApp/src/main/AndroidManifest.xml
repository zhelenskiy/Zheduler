<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- Reminders are posted from a background worker; from API 33 the user must agree first. -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS"/>
    <!-- So the schedule is running again from the moment the device is, without the app opened. -->
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED"/>

    <!--
        For the rules that fire on arriving somewhere or leaving it. Coarse is enough for a fence
        of a few hundred metres, and is declared alongside fine so a user who grants only the
        approximate position still gets the feature.

        The standing one is what lets a sweep ask while nothing of the app is on the screen, which
        is the difference between arriving home being noticed then and being noticed next time the
        app is opened. From Android 10 it is a prompt of its own and may only be asked for once the
        others are held; the places screen offers it separately.

        None of the three is asked for unless a rule is actually watching somewhere.
    -->
    <uses-permission android:name="android.permission.ACCESS_COARSE_LOCATION"/>
    <uses-permission android:name="android.permission.ACCESS_FINE_LOCATION"/>
    <uses-permission android:name="android.permission.ACCESS_BACKGROUND_LOCATION"/>

    <!--
        A boundary is a moment, not a state. The sweeps WorkManager books only sample where the
        device is, so someone who leaves and comes back between two of them has crossed twice and
        neither crossing is anywhere to be seen. A foreground service is the only thing the system
        will let keep running to catch them — and is asked for only while a rule is actually
        waiting on a place. See LocationWatchService.
    -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE"/>
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_LOCATION"/>

    <application
            android:name=".ZhedulerApplication"
            android:allowBackup="true"
            android:icon="@mipmap/ic_launcher"
            android:label="@string/app_name"
            android:roundIcon="@mipmap/ic_launcher_round"
            android:supportsRtl="true"
            android:theme="@android:style/Theme.Material.Light.NoActionBar">
        <activity
                android:exported="true"
                android:name=".MainActivity">
            <intent-filter>
                <action android:name="android.intent.action.MAIN"/>

                <category android:name="android.intent.category.LAUNCHER"/>
            </intent-filter>
        </activity>

        <!--
            How the system reaches a sound the user added. The files sit in the app's own storage,
            which the process that plays a notification cannot read; it is handed a content URI
            from here instead, one grant at a time.
        -->
        <provider
                android:name="androidx.core.content.FileProvider"
                android:authorities="${applicationId}.sounds"
                android:exported="false"
                android:grantUriPermissions="true">
            <meta-data
                    android:name="android.support.FILE_PROVIDER_PATHS"
                    android:resource="@xml/sound_paths"/>
        </provider>

        <!--
            Runs only while some rule is waiting on a place, and is stopped again the moment none
            is. Not exported: nothing outside the app has any business starting it.
        -->
        <service
                android:name="com.zhelenskiy.zheduler.zheduler.geo.LocationWatchService"
                android:exported="false"
                android:foregroundServiceType="location"/>

        <!--
            Not exported: every action below is a protected system broadcast, so nothing else can
            send them and nothing else needs to reach this.
        -->
        <receiver
                android:name=".events.ScheduleRefreshReceiver"
                android:exported="false">
            <intent-filter>
                <action android:name="android.intent.action.BOOT_COMPLETED"/>
                <action android:name="android.intent.action.MY_PACKAGE_REPLACED"/>
                <action android:name="android.intent.action.TIMEZONE_CHANGED"/>
                <action android:name="android.intent.action.TIME_SET"/>
            </intent-filter>
        </receiver>
    </application>

</manifest>
